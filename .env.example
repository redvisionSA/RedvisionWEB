# Variables de entorno para api/contacto.js (envio de correo del formulario
# de contacto). Se cargan en Cloudflare Pages: proyecto redvision-web > Settings > Variables and secrets.
# Este archivo es solo documentacion -no se lee en tiempo de build- y no
# debe contener valores reales.

# Obligatoria. API key de https://resend.com (Dashboard > API Keys).
RESEND_API_KEY=

# Opcional. Remitente del correo. Sin esta variable se usa la direccion de
# prueba de Resend (onboarding@resend.dev), que funciona pero se ve menos
# profesional. Requiere verificar el dominio propio en Resend primero
# (Domains > Add Domain) antes de usar una direccion de ese dominio aca.
RESEND_FROM="REDVISION Web <contacto@redvision.com.ar>"

# Opcional. Casilla que recibe las consultas del formulario. Por defecto usa
# la misma casilla que src/datos/empresa.js (ecommerce2.redvision@gmail.com).
CONTACTO_EMAIL_DESTINO=

# ---------------------------------------------------------------------------
# Tienda (ecommerce). Contrato del catalogo: docs/CATALOGO_API.md

# Endpoint publico de solo lectura del ERP con el catalogo de REDVISION.
# Lo lee el navegador (prefijo VITE_, se incrusta en el build). Sin esta
# variable, en desarrollo se usa un catalogo de demostracion y en produccion
# la tienda muestra "catalogo en actualizacion" (nunca inventa productos).
VITE_CATALOGO_URL=

# Opcional. El mismo endpoint, leido por api/pedido.js para poner precio a
# cada pedido en el servidor. Si falta, se usa VITE_CATALOGO_URL.
CATALOGO_URL=

# Opcional. Casilla que recibe los pedidos de la tienda. Si falta, se usa
# CONTACTO_EMAIL_DESTINO y despues la casilla de src/datos/empresa.js.
PEDIDOS_EMAIL_DESTINO=

# ---------------------------------------------------------------------------
# Cuentas de clientes (Gremio, Mayorista, Distribuidor): /cuenta/*
# Base de la tienda en el ERP, sin barra final. La lee el navegador. Sin la
# variable se usa la de produccion (https://api-erp.redvision.com.ar/shop/redvision).
# Para probar en local contra el ERP: http://localhost:<puerto>/shop/redvision
# (el CORS del ERP acepta localhost:5173 y :5180 fuera de produccion).
VITE_CUENTAS_URL=
