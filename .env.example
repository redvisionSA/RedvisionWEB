# Variables de entorno para api/contacto.js (envio de correo del formulario
# de contacto). Se cargan en Vercel: Project Settings > Environment Variables.
# Este archivo es solo documentacion -no se lee en tiempo de build- y no
# debe contener valores reales.

# Obligatoria. API key de https://resend.com (Dashboard > API Keys).
RESEND_API_KEY=

# Opcional. Remitente del correo. Sin esta variable se usa la direccion de
# prueba de Resend (onboarding@resend.dev), que funciona pero se ve menos
# profesional. Requiere verificar el dominio propio en Resend primero
# (Domains > Add Domain) antes de usar una direccion de ese dominio aca.
RESEND_FROM="REDVISION Web <contacto@redvision.com.ar>"

# Opcional. Casilla que recibe las consultas del formulario. Por defecto usa
# la misma casilla que src/datos/empresa.js (ecommerce2.redvision@gmail.com).
CONTACTO_EMAIL_DESTINO=
